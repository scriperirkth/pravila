		<Алгоритм Имя="ОБМЕН_СтрукутураПособияОплатаДнейУходаЗаДетьмиИнвал" ИспользуетсяПриЗагрузке="false">
			<Текст>ОБМЕН_СтрукутураПособия = новый Структура("ПериодДействияНачало,ПериодДействияКонец,ВидРасчета");
ЗапросОплатаДнейУхода = Новый Запрос;
ЗапросОплатаДнейУхода.Текст = 
"ВЫБРАТЬ
|	Начисления.ПериодДействияНачало КАК ПериодДействияНачало,
|	Начисления.ПериодДействияКонец КАК ПериодДействияКонец,
|	Начисления.ВидРасчета КАК ВидРасчета
|ИЗ
|	РегистрРасчета.Начисления КАК Начисления
|ГДЕ
|	Начисления.Регистратор ССЫЛКА Документ.ОплатаДнейУходаЗаДетьмиИнвалидами
|	И Начисления.ПериодРегистрации = &amp;ПериодРегистрации
|	И Начисления.ПериодДействияНачало = &amp;ПериодДействияНачало
|	И Начисления.ФизическоеЛицо = &amp;ФизическоеЛицо
|	И Начисления.Сотрудник = &amp;Сотрудник
|	И Начисления.Организация = &amp;Организация";

ЗапросОплатаДнейУхода.УстановитьПараметр("Организация", ВыборкаДетальныеЗаписи.Организация);
ЗапросОплатаДнейУхода.УстановитьПараметр("ПериодДействияНачало", ВыборкаДетальныеЗаписи.ДатаСтраховогоСлучая);
ЗапросОплатаДнейУхода.УстановитьПараметр("ПериодРегистрации", ВыборкаДетальныеЗаписи.Период);
ЗапросОплатаДнейУхода.УстановитьПараметр("Сотрудник", ВыборкаДетальныеЗаписи.Сотрудник);
ЗапросОплатаДнейУхода.УстановитьПараметр("ФизическоеЛицо", ВыборкаДетальныеЗаписи.ФизическоеЛицо);
РезультатЗапросаОплатаДнейУхода = ЗапросОплатаДнейУхода.Выполнить();
ВыборкаОплатаДнейУхода = РезультатЗапросаОплатаДнейУхода.Выбрать();
Пока ВыборкаОплатаДнейУхода.Следующий() Цикл
	ЗаполнитьЗначенияСвойств(ОБМЕН_СтрукутураПособия, ВыборкаОплатаДнейУхода);
КонецЦикла;
</Текст>
